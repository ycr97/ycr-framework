<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.ycr.framework</groupId>
    <artifactId>ycr-framework-bom</artifactId>
    <version>${revision}</version>
    <packaging>pom</packaging>

    <name>YCR Framework BOM</name>
    <description>YCR 框架模块版本管理，脚手架项目通过 import 此 BOM 引入所有 starter</description>

    <properties>
        <revision>0.9.0-RC4</revision>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!--
              嵌套 import 框架的依赖中枢：ycr-dependencies 已集中托管全部第三方版本
              （spring-boot-dependencies / mybatis-plus / cola / mapstruct / hutool / sa-token 等）。
              消费方只 import 本 BOM 即同时获得「框架 starter 坐标 + 全部第三方版本管理」，
              版本单一真源仍是 ycr-dependencies，本处零重复声明。
              import scope 仅取其 dependencyManagement，不会带入 ycr-dependencies 的 dependencies/build。
            -->
            <dependency>
                <groupId>com.ycr.framework</groupId>
                <artifactId>ycr-dependencies</artifactId>
                <version>${revision}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <dependency>
                <groupId>com.ycr.framework</groupId>
                <artifactId>ycr-starter-core</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.ycr.framework</groupId>
                <artifactId>ycr-common</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.ycr.framework</groupId>
                <artifactId>ycr-starter-json</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.ycr.framework</groupId>
                <artifactId>ycr-starter-web</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.ycr.framework</groupId>
                <artifactId>ycr-starter-validation</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.ycr.framework</groupId>
                <artifactId>ycr-starter-api-doc</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.ycr.framework</groupId>
                <artifactId>ycr-starter-context</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.ycr.framework</groupId>
                <artifactId>ycr-starter-data-core</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.ycr.framework</groupId>
                <artifactId>ycr-starter-data-mp</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.ycr.framework</groupId>
                <artifactId>ycr-starter-cache</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.ycr.framework</groupId>
                <artifactId>ycr-starter-cache-jetcache</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.ycr.framework</groupId>
                <artifactId>ycr-starter-data-permission</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.ycr.framework</groupId>
                <artifactId>ycr-starter-id-generate</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.ycr.framework</groupId>
                <artifactId>ycr-starter-auth-satoken</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.ycr.framework</groupId>
                <artifactId>ycr-starter-auth-oauth2-resource-server</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.ycr.framework</groupId>
                <artifactId>ycr-starter-security</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.ycr.framework</groupId>
                <artifactId>ycr-starter-encrypt</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.ycr.framework</groupId>
                <artifactId>ycr-starter-protect</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.ycr.framework</groupId>
                <artifactId>ycr-starter-log</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.ycr.framework</groupId>
                <artifactId>ycr-starter-trace</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.ycr.framework</groupId>
                <artifactId>ycr-starter-excel</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.ycr.framework</groupId>
                <artifactId>ycr-starter-ratelimiter</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.ycr.framework</groupId>
                <artifactId>ycr-starter-idempotent</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.ycr.framework</groupId>
                <artifactId>ycr-starter-i18n</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.ycr.framework</groupId>
                <artifactId>ycr-starter-captcha</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.ycr.framework</groupId>
                <artifactId>ycr-starter-messaging</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.ycr.framework</groupId>
                <artifactId>ycr-starter-storage</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.ycr.framework</groupId>
                <artifactId>ycr-starter-feign</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.ycr.framework</groupId>
                <artifactId>ycr-starter-tenant</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.ycr.framework</groupId>
                <artifactId>ycr-starter-sdk</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.ycr.framework</groupId>
                <artifactId>ycr-starter-translate</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.ycr.framework</groupId>
                <artifactId>ycr-starter-business</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.ycr.framework</groupId>
                <artifactId>ycr-starter-crud</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.ycr.framework</groupId>
                <artifactId>ycr-starter-ddd-core</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.ycr.framework</groupId>
                <artifactId>ycr-starter-ddd-extension</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.ycr.framework</groupId>
                <artifactId>ycr-starter-ddd-statemachine</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.ycr.framework</groupId>
                <artifactId>ycr-starter-mq-core</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.ycr.framework</groupId>
                <artifactId>ycr-starter-mq-rocketmq</artifactId>
                <version>${revision}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>flatten-maven-plugin</artifactId>
                <version>1.6.0</version>
                <configuration>
                    <updatePomFile>true</updatePomFile>
                    <flattenMode>resolveCiFriendliesOnly</flattenMode>
                </configuration>
                <executions>
                    <execution>
                        <id>flatten</id>
                        <phase>process-resources</phase>
                        <goals>
                            <goal>flatten</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>flatten.clean</id>
                        <phase>clean</phase>
                        <goals>
                            <goal>clean</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
