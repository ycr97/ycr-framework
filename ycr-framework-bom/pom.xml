<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.ycr.framework</groupId>
    <artifactId>ycr-framework-bom</artifactId>
    <version>${revision}</version>
    <packaging>pom</packaging>

    <name>YCR Framework BOM</name>
    <description>YCR 框架模块版本管理，脚手架项目通过 import 此 BOM 引入所有 starter</description>

    <properties>
        <revision>1.0.0-SNAPSHOT</revision>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.ycr.framework</groupId>
                <artifactId>ycr-starter-core</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.ycr.framework</groupId>
                <artifactId>ycr-starter-json</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.ycr.framework</groupId>
                <artifactId>ycr-starter-web</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.ycr.framework</groupId>
                <artifactId>ycr-starter-validation</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.ycr.framework</groupId>
                <artifactId>ycr-starter-api-doc</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.ycr.framework</groupId>
                <artifactId>ycr-starter-context</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.ycr.framework</groupId>
                <artifactId>ycr-starter-data-core</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.ycr.framework</groupId>
                <artifactId>ycr-starter-data-mp</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.ycr.framework</groupId>
                <artifactId>ycr-starter-cache</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.ycr.framework</groupId>
                <artifactId>ycr-starter-data-permission</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.ycr.framework</groupId>
                <artifactId>ycr-starter-id-generate</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.ycr.framework</groupId>
                <artifactId>ycr-starter-auth</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.ycr.framework</groupId>
                <artifactId>ycr-starter-security</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.ycr.framework</groupId>
                <artifactId>ycr-starter-encrypt</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.ycr.framework</groupId>
                <artifactId>ycr-starter-log</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.ycr.framework</groupId>
                <artifactId>ycr-starter-trace</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.ycr.framework</groupId>
                <artifactId>ycr-starter-excel</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.ycr.framework</groupId>
                <artifactId>ycr-starter-ratelimiter</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.ycr.framework</groupId>
                <artifactId>ycr-starter-idempotent</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.ycr.framework</groupId>
                <artifactId>ycr-starter-i18n</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.ycr.framework</groupId>
                <artifactId>ycr-starter-captcha</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.ycr.framework</groupId>
                <artifactId>ycr-starter-messaging</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.ycr.framework</groupId>
                <artifactId>ycr-starter-storage</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.ycr.framework</groupId>
                <artifactId>ycr-starter-feign</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.ycr.framework</groupId>
                <artifactId>ycr-starter-tenant</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.ycr.framework</groupId>
                <artifactId>ycr-starter-sdk</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.ycr.framework</groupId>
                <artifactId>ycr-starter-translate</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.ycr.framework</groupId>
                <artifactId>ycr-starter-business</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.ycr.framework</groupId>
                <artifactId>ycr-starter-crud</artifactId>
                <version>${revision}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>flatten-maven-plugin</artifactId>
                <version>1.6.0</version>
                <configuration>
                    <updatePomFile>true</updatePomFile>
                    <flattenMode>resolveCiFriendliesOnly</flattenMode>
                </configuration>
                <executions>
                    <execution>
                        <id>flatten</id>
                        <phase>process-resources</phase>
                        <goals>
                            <goal>flatten</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>flatten.clean</id>
                        <phase>clean</phase>
                        <goals>
                            <goal>clean</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
