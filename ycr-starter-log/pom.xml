<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.ycr.framework</groupId>
        <artifactId>ycr-framework</artifactId>
        <version>${revision}</version>
    </parent>

    <artifactId>ycr-starter-log</artifactId>
    <name>YCR Starter Log</name>
    <description>操作日志模块 - AOP 采集操作日志，敏感字段脱敏，可插拔处理器与异步落库</description>

    <dependencies>
        <!-- 取 UserContextHolder 作操作人来源，并传递带入 core / spring-boot -->
        <dependency>
            <groupId>com.ycr.framework</groupId>
            <artifactId>ycr-starter-context</artifactId>
            <version>${revision}</version>
        </dependency>
        <dependency>
            <groupId>com.ycr.framework</groupId>
            <artifactId>ycr-starter-trace</artifactId>
            <version>${revision}</version>
        </dependency>
        <!-- AspectJ 切面 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aop</artifactId>
        </dependency>
        <!-- 编译期取 RequestContextHolder / HttpServletRequest；运行期由宿主 web 应用提供，故 optional -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>cn.hutool</groupId>
            <artifactId>hutool-core</artifactId>
        </dependency>
        <!-- UA 解析（UserAgentUtil） -->
        <dependency>
            <groupId>cn.hutool</groupId>
            <artifactId>hutool-http</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <version>3.3.1</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-source-plugin</artifactId>
                <version>3.1.0</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.5</version>
                <configuration>
                    <argLine>-javaagent:"${settings.localRepository}/net/bytebuddy/byte-buddy-agent/${byte-buddy.version}/byte-buddy-agent-${byte-buddy.version}.jar"</argLine>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
