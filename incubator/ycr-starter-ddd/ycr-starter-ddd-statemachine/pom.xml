<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.ycr.framework</groupId>
        <artifactId>ycr-starter-ddd</artifactId>
        <version>${revision}</version>
    </parent>

    <artifactId>ycr-starter-ddd-statemachine</artifactId>
    <name>YCR Starter DDD StateMachine</name>
    <description>[Experimental] DDD 状态机 - 参考 COLA StateMachine 的轻量级、不可变、线程安全状态机（流式 DSL + 条件分支）</description>

    <properties>
        <ycr.module.maturity>experimental</ycr.module.maturity>
    </properties>

    <dependencies>
        <!-- 运行/构建期错误统一用 Biz/SysException 承载，让 core 依赖真正落地 -->
        <dependency>
            <groupId>com.ycr.framework</groupId>
            <artifactId>ycr-starter-core</artifactId>
            <version>${revision}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.5</version>
            </plugin>
        </plugins>
    </build>
</project>
